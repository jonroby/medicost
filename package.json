{
  "name": "medicost",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "db:migrate": "bun run --filter @medicost/db migrate",
    "api:dev": "bun run --filter @medicost/api dev",
    "client:dev": "bun run --filter @medicost/client dev",
    "ingest": "bun run --filter @medicost/sources ingest"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
